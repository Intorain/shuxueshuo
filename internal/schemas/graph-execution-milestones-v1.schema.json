{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graph-execution-milestones/v1",
  "type": "object",
  "required": [
    "schema_version",
    "default",
    "milestones"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "graph-execution-milestones/v1"
    },
    "default": {
      "type": "string",
      "minLength": 1
    },
    "milestones": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
