{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graph-method-execution/v1",
  "type": "object",
  "required": [
    "schema_version",
    "method",
    "inputs",
    "steps",
    "outputs",
    "exits"
  ],
  "properties": {
    "schema_version": {
      "const": "graph-method-execution/v1"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "calls",
          "judgments",
          "display_units"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "calls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "public_ref",
                "capability",
                "inputs",
                "outputs"
              ],
              "properties": {
                "public_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "capability": {
                  "type": "string",
                  "minLength": 1
                },
                "inputs": {
                  "type": "object"
                },
                "outputs": {
                  "type": "object"
                },
                "guard": {}
              }
            }
          },
          "judgments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "depends_on",
                "function",
                "options"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "depends_on": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "function": {
                  "type": "string",
                  "minLength": 1
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "cases": {
            "type": [
              "object",
              "null"
            ]
          },
          "display_units": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "depends_on",
                "template",
                "bindings"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "depends_on": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "template": {
                  "type": "string",
                  "minLength": 1
                },
                "bindings": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "outputs": {
      "type": "object"
    },
    "exits": {
      "type": "object"
    }
  }
}
