{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graph-method-selection/v1",
  "type": "object",
  "required": [
    "schema_version",
    "rule",
    "branches",
    "plane_axes",
    "recommendation"
  ],
  "properties": {
    "schema_version": {
      "const": "graph-method-selection/v1"
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "branch",
          "target",
          "route_id",
          "trigger",
          "premises",
          "plane",
          "messages"
        ],
        "properties": {
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "route_id": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "feature"
              ],
              "properties": {
                "feature": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  }
                },
                "equals": {},
                "in": {
                  "type": "array",
                  "items": {},
                  "minItems": 1
                }
              },
              "oneOf": [
                {
                  "required": [
                    "equals"
                  ],
                  "not": {
                    "required": [
                      "in"
                    ]
                  }
                },
                {
                  "required": [
                    "in"
                  ],
                  "not": {
                    "required": [
                      "equals"
                    ]
                  }
                }
              ]
            }
          },
          "premises": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "plane": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "messages": {
            "type": "object"
          }
        }
      },
      "minItems": 1
    },
    "plane_axes": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "object",
          "required": [
            "feature",
            "label",
            "options",
            "feedback"
          ],
          "properties": {
            "feature": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "value",
                  "label"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "note": {
                    "type": "string"
                  }
                }
              },
              "minItems": 1
            },
            "feedback": {
              "type": "object"
            }
          }
        },
        "y": {
          "type": "object",
          "required": [
            "feature",
            "label",
            "options",
            "feedback"
          ],
          "properties": {
            "feature": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "value",
                  "label"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "note": {
                    "type": "string"
                  }
                }
              },
              "minItems": 1
            },
            "feedback": {
              "type": "object"
            }
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": [
        "priority",
        "rules"
      ],
      "properties": {
        "priority": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "when"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "when": {
                "type": "object"
              },
              "preferred": {
                "type": "string",
                "minLength": 1
              },
              "superseded": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "minItems": 1
        }
      }
    }
  }
}
