    {
      "id": "case-merge--intersect-endpoint",
      "question": "$x$ 满足 $-1\\le x<3$，并且 $x>0$。$x$ 的取值范围是什么？",
      "type": "choice",
      "options": [
        {
          "value": "closed",
          "label": "$0\\le x<3$",
          "feedback": "$x>0$ 不含 $0$；交集里的每个数都要同时满足两个条件，两边都含才含。"
        },
        {
          "value": "first",
          "label": "$-1\\le x<3$",
          "feedback": "还要满足 $x>0$。"
        },
        {
          "value": "right",
          "label": "$0<x<3$"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "case-merge",
        "item": "intersect-endpoint"
      }
    },
    {
      "id": "case-merge--union-endpoint",
      "given": "情况①得 $-2<a\\le1$，情况②得 $1<a<3$。",
      "question": "合并后 $a$ 的取值范围是什么？",
      "type": "choice",
      "options": [
        {
          "value": "hole",
          "label": "$-2<a<3$，且 $a\\ne1$",
          "feedback": "$a=1$ 在情况①的结果里；并集里有一边含就含。"
        },
        {
          "value": "union",
          "label": "$-2<a<3$"
        },
        {
          "value": "empty",
          "label": "无解",
          "feedback": "两种情况满足其一即可，取并集，不要求同时满足。"
        }
      ],
      "answer": "union",
      "origin": {
        "node": "case-merge",
        "item": "union-endpoint"
      }
    },
    {
      "id": "case-merge--which-union",
      "question": "下面哪些地方应该取并集？",
      "type": "multi",
      "options": [
        {
          "value": "cases",
          "label": "分类讨论后，把各种情况的结果合起来"
        },
        {
          "value": "premise",
          "label": "同一种情况里，解出的范围与这种情况的前提",
          "feedback": "同一种情况里，前提和解出的条件要同时成立，取交集。"
        },
        {
          "value": "ends",
          "label": "两个端点值都要满足的条件",
          "feedback": "两个端点要同时满足，取交集。"
        },
        {
          "value": "product",
          "label": "解 $(x-1)(x-3)>0$ 得到的 $x<1$ 与 $x>3$"
        }
      ],
      "answer": [
        "cases",
        "product"
      ],
      "origin": {
        "node": "case-merge",
        "item": "which-union"
      }
    }
  ]
