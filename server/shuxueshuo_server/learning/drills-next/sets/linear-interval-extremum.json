      "question": "下面哪些说法是对的？",
      "type": "multi",
      "options": [
        {
          "value": "max",
          "label": "最大值一定在某个端点取到"
        },
        {
          "value": "min",
          "label": "$k>0$ 时最小值是 $f(q)$",
          "feedback": "$k>0$ 时函数递增，最小值是左端点的值 $f(p)$。"
        },
        {
          "value": "neg",
          "label": "$f(p)<0$ 且 $f(q)<0$ 时，$f(t)$ 在 $[p,q]$ 上恒小于 $0$"
        },
        {
          "value": "or",
          "label": "$f(p)>0$ 或 $f(q)>0$ 就能保证恒大于 $0$",
          "feedback": "要两端都大于 $0$，例如 $f(t)=t$ 在 $[-1,1]$ 上，$f(1)>0$，但 $f(-1)<0$。"
        }
      ],
      "answer": [
        "max",
        "neg"
      ],
