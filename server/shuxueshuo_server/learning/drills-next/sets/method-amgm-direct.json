        {
          "value": "five",
          "label": "$5$",
          "feedback": "$5$ 只是常数部分，$\\frac ba+\\frac{4a}b$ 还至少是 $4$。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "homogeneous-expression",
        "item": "compute"
      }
    },
