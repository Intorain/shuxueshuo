    {
      "id": "method-elimination--solve",
      "given": "$x>0$，$y>0$，$x(y+1)=9$，求 $x+y$ 的最小值。",
      "question": "第一步用 $y$ 表示 $x$，结果是什么？",
      "type": "choice",
      "options": [
        {
          "value": "split",
          "label": "$x=\\frac9y-1$",
          "feedback": "两边除以 $y+1$，得 $x=\\frac9{y+1}$。"
        },
        {
          "value": "right",
          "label": "$x=\\frac9{y+1}$"
        },
        {
          "value": "minus",
          "label": "$x=9-y$",
          "feedback": "条件是乘积 $x(y+1)=9$，不是和。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "method-elimination",
        "item": "solve"
      }
    },
    {
      "id": "method-elimination--range",
      "question": "$x>0$，$y>0$，$x+y=1$，用 $x$ 表示 $xy$ 后，$x$ 的取值范围是什么？",
      "type": "choice",
      "options": [
        {
          "value": "right",
          "label": "$0<x<1$"
        },
        {
          "value": "pos",
          "label": "$x>0$",
          "feedback": "$y=1-x>0$ 还要求 $x<1$。"
        },
        {
          "value": "closed",
          "label": "$0\\le x\\le1$",
          "feedback": "$x>0$、$y>0$ 都是严格的，端点取不到。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "method-elimination",
        "item": "range"
      },
      "entry": "feasible"
    },
    {
      "id": "method-elimination--when",
      "question": "什么时候优先想到消元？",
      "type": "choice",
      "options": [
        {
          "value": "denom",
          "label": "条件里出现分母",
          "feedback": "分母是整体时更适合换元；消元看的是能否方便地解出一个变量。"
        },
        {
          "value": "homo",
          "label": "目标与条件次数能配齐",
          "feedback": "这是配齐次式的信号。"
