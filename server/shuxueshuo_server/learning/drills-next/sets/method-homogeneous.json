{
  "node": "method-homogeneous",
  "items": [
    {
      "id": "homogeneous-expression--degree",
      "question": "$\\frac{x^2}y$ 是几次式？",
      "type": "choice",
      "options": [
        {
          "value": "two",
          "label": "二次",
          "feedback": "分母的次数要减掉：$2-1=1$。"
        },
        {
          "value": "three",
          "label": "三次",
          "feedback": "除以 $y$ 是乘 $y^{-1}$，次数是 $2+(-1)$。"
        },
        {
          "value": "right",
          "label": "一次"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "homogeneous-expression",
        "item": "degree"
      },
      "entry": "degree"
    },
    {
      "id": "homogeneous-expression--zero-degree",
      "question": "下面哪个是零次式？",
      "type": "choice",
      "options": [
        {
          "value": "right",
          "label": "$\\frac xy+\\frac yx$"
        },
        {
          "value": "mixed",
          "label": "$x+\\frac1y$",
          "feedback": "$x$ 是一次，$\\frac1y$ 是负一次，各项次数不同。"
        },
        {
          "value": "neg",
          "label": "$\\frac{x+y}{xy}$",
          "feedback": "分子一次、分母二次，是负一次式。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "homogeneous-expression",
        "item": "zero-degree"
      },
      "entry": "degree"
    },
    {
      "id": "homogeneous-expression--multiply",
      "question": "$a+b=1$ 时，要把 $\\frac1a+\\frac2b$ 配成零次式，应乘上什么？",
      "type": "choice",
      "options": [
        {
          "value": "square",
          "label": "$(a+b)^2$",
          "feedback": "负一次乘二次得到一次式，不是零次。"
        },
        {
          "value": "right",
          "label": "$a+b$"
        },
        {
          "value": "ab",
          "label": "$ab$",
          "feedback": "$ab$ 不等于 $1$，乘上去式子的值就变了。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "homogeneous-expression",
        "item": "multiply"
      },
      "entry": "fill"
    },
    {
      "id": "homogeneous-expression--not-one",
      "question": "$2a+b=2$ 时，$\\frac1a+\\frac1b$ 应写成什么？",
      "type": "choice",
      "options": [
        {
          "value": "direct",
          "label": "$\\left(\\frac1a+\\frac1b\\right)(2a+b)$",
          "feedback": "$2a+b=2$，不是 $1$，直接乘值变成原来的 $2$ 倍。"
        },
        {
          "value": "double",
          "label": "$2\\left(\\frac1a+\\frac1b\\right)(2a+b)$",
          "feedback": "应乘 $\\frac{2a+b}2=1$，系数是 $\\frac12$。"
        },
        {
          "value": "right",
          "label": "$\\frac12\\left(\\frac1a+\\frac1b\\right)(2a+b)$"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "homogeneous-expression",
        "item": "not-one"
      },
      "entry": "fill"
    },
    {
      "id": "homogeneous-expression--ratio",
      "question": "$x,y>0$ 时，$\\frac{x^2+y^2}{xy}$ 的值只和什么有关？",
      "type": "choice",
      "options": [
        {
          "value": "sum",
          "label": "$x+y$",
          "feedback": "$x=1,y=1$ 和 $x=0.5,y=1.5$ 的和相同，值却不同。"
        },
        {
          "value": "right",
          "label": "比值 $\\frac xy$"
        },
        {
          "value": "product",
          "label": "$xy$",
          "feedback": "$x=y=1$ 和 $x=4,y=\\frac14$ 的积相同，值却不同。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "homogeneous-expression",
        "item": "ratio"
      },
      "entry": "degree"
    },
    {
      "id": "homogeneous-expression--statements",
      "question": "下面哪些说法是对的？",
      "type": "multi",
      "options": [
        {
          "value": "scale",
          "label": "$x$、$y$ 同时乘 $k$（$k>0$），零次式的值不变"
        },
        {
          "value": "one-one",
          "label": "一次式乘一次式得零次式",
          "feedback": "次数相加：$1+1=2$，得到二次式。"
        },
        {
          "value": "neg-one",
          "label": "负一次式乘一次式得零次式"
        },
        {
          "value": "coef",
          "label": "数字系数也算进次数",
          "feedback": "次数只看字母的指数，$5x$ 和 $x$ 都是一次。"
        }
      ],
      "answer": [
        "scale",
        "neg-one"
      ],
      "origin": {
        "node": "homogeneous-expression",
        "item": "statements"
      },
      "entry": "degree"
    },
    {
      "id": "method-homogeneous--first-step",
      "question": "$a,b>0$，$2a+3b=6$，求 $\\frac2a+\\frac3b$ 的最小值，第一步写成什么？",
      "type": "choice",
      "options": [
        {
          "value": "right",
          "label": "$\\frac16\\left(\\frac2a+\\frac3b\\right)(2a+3b)$"
        },
        {
          "value": "six",
          "label": "$6\\left(\\frac2a+\\frac3b\\right)(2a+3b)$",
          "feedback": "乘的是 $\\frac{2a+3b}6=1$，系数是 $\\frac16$。"
        },
        {
          "value": "direct",
          "label": "$\\left(\\frac2a+\\frac3b\\right)(2a+3b)$",
          "feedback": "$2a+3b=6$，直接乘值变成原来的 $6$ 倍。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "method-homogeneous",
        "item": "first-step"
      }
    }
  ]
}
