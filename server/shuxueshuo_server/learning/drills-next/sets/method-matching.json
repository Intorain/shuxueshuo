      "question": "$x>1$ 时，$\\frac{x^2}{x-1}$ 应凑成什么？",
      "type": "choice",
      "options": [
        {
          "value": "missing",
          "label": "$x+\\frac1{x-1}$",
          "feedback": "$x^2=(x-1)(x+1)+1$，所以 $\\frac{x^2}{x-1}=x+1+\\frac1{x-1}$，少了 $1$。"
        },
