{
  "node": "method-substitution",
  "items": [
    {
      "id": "homogeneous-expression--substitute",
      "question": "$x,y>0$，令 $t=\\frac xy$，$\\frac xy+\\frac{4y}x$ 变成什么？",
      "type": "choice",
      "options": [
        {
          "value": "flip",
          "label": "$\\frac1t+4t$",
          "feedback": "$\\frac xy=t$，$\\frac yx=\\frac1t$，所以是 $t+\\frac4t$。"
        },
        {
          "value": "right",
          "label": "$t+\\frac4t$"
        },
        {
          "value": "times",
          "label": "$t+4t$",
          "feedback": "$\\frac{4y}x=4\\cdot\\frac yx=\\frac4t$。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "homogeneous-expression",
        "item": "substitute"
      }
    },
    {
      "id": "method-substitution--rewrite",
      "given": "$x>1$，求 $\\frac{x^2-x+1}{x-1}$ 的最小值。",
      "question": "令 $t=x-1$，式子变成什么？",
      "type": "choice",
      "options": [
        {
          "value": "right",
          "label": "$t+\\frac1t+1$"
        },
        {
          "value": "missing",
          "label": "$t+\\frac1t$",
          "feedback": "$x=t+1$，分子 $=t^2+t+1$，除以 $t$ 得 $t+1+\\frac1t$。"
        },
        {
          "value": "numer",
          "label": "$t^2+t+1$",
          "feedback": "这只是分子，还要除以分母 $t$。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "method-substitution",
        "item": "rewrite"
      }
    },
    {
      "id": "method-substitution--range",
      "question": "$x\\in(1,3)$，令 $t=x-1$，$t$ 的取值范围是什么？",
      "type": "choice",
      "options": [
        {
          "value": "pos",
          "label": "$t>0$",
          "feedback": "$x<3$ 还给出 $t<2$。换元后要写出新变量的完整范围。"
        },
        {
          "value": "right",
          "label": "$t\\in(0,2)$"
        },
        {
          "value": "same",
          "label": "$t\\in(1,3)$",
          "feedback": "这是 $x$ 的范围，$t=x-1$ 要整体减 $1$。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "method-substitution",
        "item": "range"
      },
      "entry": "range"
    },
    {
      "id": "method-substitution--when",
      "question": "什么时候想到换元？",
      "type": "choice",
      "options": [
        {
          "value": "one-var",
          "label": "只要式子里只有一个变量",
          "feedback": "关键是有一个反复出现的整体，例如分母 $x-1$、$x+y$。"
        },
        {
          "value": "right",
          "label": "式子里有一个整体（如分母 $x-1$、$x+y$），把它当新变量更简单"
        },
        {
          "value": "no-range",
          "label": "想简化式子时，换元后不用管范围",
          "feedback": "新变量的范围决定了等号能不能取到，必须写出来。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "method-substitution",
        "item": "when"
      }
    },
    {
      "id": "symmetric-polynomial--construct",
      "question": "$x^2+4y^2-2xy$ 不对称，怎样换元能变成对称式？",
      "type": "choice",
      "options": [
        {
          "value": "swap",
          "label": "令 $a=2x$，$b=y$",
          "feedback": "得 $\\frac{a^2}4+4b^2-ab$，仍不对称。$4y^2=(2y)^2$，应令 $b=2y$。"
        },
        {
          "value": "direct",
          "label": "直接设 $s=x+y$，$p=xy$",
          "feedback": "不对称的式子写不成只含 $s$、$p$ 的式子，要先换元。"
        },
        {
          "value": "right",
          "label": "令 $a=x$，$b=2y$"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "symmetric-polynomial",
        "item": "construct"
      }
    }
  ]
}
