{
  "node": "method-sum-product-range",
  "items": [
    {
      "id": "method-sum-product--range",
      "question": "实数 $x$、$y$ 满足 $x^2+y^2+xy=1$，$x+y$ 的取值范围是什么？",
      "type": "choice",
      "options": [
        {
          "value": "unit",
          "label": "$[-1,1]$",
          "feedback": "$x=y=\\frac{\\sqrt3}3$ 时 $x+y=\\frac{2\\sqrt3}3>1$。由 $p=s^2-1\\le\\frac{s^2}4$ 得 $s^2\\le\\frac43$。"
        },
        {
          "value": "pos",
          "label": "$\\left[0,\\frac{2\\sqrt3}3\\right]$",
          "feedback": "$x=y=-\\frac{\\sqrt3}3$ 时 $x+y<0$。"
        },
        {
          "value": "right",
          "label": "$\\left[-\\frac{2\\sqrt3}3,\\frac{2\\sqrt3}3\\right]$"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "method-sum-product",
        "item": "range"
      }
    },
    {
      "id": "method-sum-product--positive",
      "question": "$x,y>0$，$x+y+xy=3$，$x+y$ 的最小值是多少？",
      "type": "choice",
      "options": [
        {
          "value": "three",
          "label": "$3$",
          "feedback": "$p=3-s\\le\\frac{s^2}4$，得 $(s+6)(s-2)\\ge0$，$s\\ge2$。"
        },
        {
          "value": "right",
          "label": "$2$"
        },
        {
          "value": "one",
          "label": "$1$",
          "feedback": "$s=1$ 时 $p=2>\\frac{s^2}4$，这样的实数 $x$、$y$ 不存在。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "method-sum-product",
        "item": "positive"
      }
    },
    {
      "id": "method-sum-product--product-range",
      "question": "实数 $x$、$y$ 满足 $x^2+y^2=2$，$xy$ 的取值范围是什么？",
      "type": "choice",
      "options": [
        {
          "value": "right",
          "label": "$[-1,1]$"
        },
        {
          "value": "pos",
          "label": "$[0,1]$",
          "feedback": "$x=1$，$y=-1$ 时 $xy=-1$。"
        },
        {
          "value": "upper",
          "label": "$(-\\infty,1]$",
          "feedback": "$p=\\frac{s^2-2}2$，$s\\in[-2,2]$，所以 $p\\ge-1$。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "method-sum-product",
        "item": "product-range"
      }
    },
    {
      "id": "square-nonnegative--sum-product",
      "question": "实数 $x$、$y$ 满足 $x+y=2$，$xy=p$，$p$ 的取值范围是什么？",
      "type": "choice",
      "options": [
        {
          "value": "right",
          "label": "$p\\le1$"
        },
        {
          "value": "ge",
          "label": "$p\\ge1$",
          "feedback": "$x=3$，$y=-1$ 时 $p=-3$。由 $(x-y)^2=(x+y)^2-4xy\\ge0$ 得 $4-4p\\ge0$。"
        },
        {
          "value": "lt",
          "label": "$p<1$",
          "feedback": "$x=y=1$ 时 $p=1$，等号取得到。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "square-nonnegative",
        "item": "sum-product"
      }
    },
    {
      "id": "square-nonnegative--both-sides",
      "question": "$a^2+b^2=2$，$ab$ 的取值范围是什么？",
      "type": "choice",
      "options": [
        {
          "value": "upper",
          "label": "$ab\\le1$",
          "feedback": "只用了 $(a-b)^2\\ge0$。由 $(a+b)^2\\ge0$ 还得 $2ab\\ge-2$。"
        },
        {
          "value": "pos",
          "label": "$0\\le ab\\le1$",
          "feedback": "$a=1$，$b=-1$ 时 $ab=-1$。"
        },
        {
          "value": "right",
          "label": "$-1\\le ab\\le1$"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "square-nonnegative",
        "item": "both-sides"
      }
    },
    {
      "id": "symmetric-polynomial--range",
      "question": "实数 $x$、$y$ 满足 $x^2+y^2=2$，$x+y$ 的取值范围是什么？",
      "type": "choice",
      "options": [
        {
          "value": "pos",
          "label": "$[0,2]$",
          "feedback": "$x=y=-1$ 时 $x+y=-2$。"
        },
        {
          "value": "right",
          "label": "$[-2,2]$"
        },
        {
          "value": "root",
          "label": "$[-\\sqrt2,\\sqrt2]$",
          "feedback": "$x=y=1$ 时 $x+y=2>\\sqrt2$。由 $p=\\frac{s^2-2}2\\le\\frac{s^2}4$ 得 $s^2\\le4$。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "symmetric-polynomial",
        "item": "range"
      }
    }
  ]
}
