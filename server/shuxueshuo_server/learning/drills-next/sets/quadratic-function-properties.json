    {
      "id": "method-complete-square--statements",
      "given": "把二次式配方成 $a(x-h)^2+k$。",
      "question": "下面哪些说法是对的？",
      "type": "multi",
      "options": [
        {
          "value": "up",
          "label": "$x$ 取全体实数、$a>0$ 时，最小值是 $k$"
        },
        {
          "value": "always",
          "label": "不论 $x$ 的范围，最值一定是 $k$",
          "feedback": "$x=h$ 不在范围里时取不到 $k$，要按区间求最值。"
        },
        {
          "value": "down",
          "label": "$x$ 取全体实数、$a<0$ 时，得到的是最大值 $k$"
        },
        {
          "value": "add-only",
          "label": "配方时只要加上一次项系数一半的平方，不用再减",
          "feedback": "加了多少就要减多少，式子的值才不变。"
        }
      ],
      "answer": [
        "up",
        "down"
      ],
      "origin": {
        "node": "method-complete-square",
        "item": "statements"
      },
      "entry": "vertex"
    },
    {
      "id": "quadratic-function-properties--up-no-root",
      "given": "$f(x)=x^2-2x+3$。",
      "question": "下面哪一句是对的？",
      "type": "choice",
      "options": [
        {
          "value": "exists",
          "label": "存在 $x$ 使 $f(x)<0$",
          "feedback": "开口向上且 $\\Delta=4-12<0$，图像全在 $x$ 轴上方，没有函数值小于 $0$ 的点。"
        },
        {
          "value": "always",
          "label": "对一切实数 $x$，$f(x)>0$"
        },
        {
          "value": "roots",
          "label": "$f(x)=0$ 有两个不相等的实根",
          "feedback": "$\\Delta=(-2)^2-4\\times3=-8<0$，方程没有实根。"
        }
      ],
      "answer": "always",
      "origin": {
        "node": "quadratic-function-properties",
        "item": "up-no-root"
      },
      "entry": "side"
    },
    {
      "id": "quadratic-function-properties--param-opening",
      "question": "$y=(m^2+1)x^2-2x+1$ 的图像开口方向是？",
      "type": "choice",
      "options": [
        {
          "value": "up",
          "label": "一定向上"
        },
        {
          "value": "split",
          "label": "要按 $m$ 的正负分类讨论",
          "feedback": "不管 $m$ 取什么，$m^2+1\\ge1>0$，不需要分类。"
        },
        {
          "value": "down",
          "label": "$m<0$ 时向下",
          "feedback": "开口看二次项系数 $m^2+1$ 的符号，它总是正的。"
        }
      ],
      "answer": "up",
      "origin": {
        "node": "quadratic-function-properties",
        "item": "param-opening"
      },
      "entry": "definition"
    },
    {
      "id": "quadratic-function-properties--tangent-meaning",
      "given": "$y=x^2+bx+c$ 的判别式 $\\Delta=0$。",
      "question": "下面哪一句是对的？",
      "type": "choice",
      "options": [
        {
          "value": "above",
          "label": "对一切实数 $x$，$y>0$",
          "feedback": "顶点在 $x$ 轴上，顶点处 $y=0$，只能说 $y\\ge0$。"
        },
        {
          "value": "none",
          "label": "图像和 $x$ 轴没有公共点",
          "feedback": "这是 $\\Delta<0$ 的情况。"
        },
        {
          "value": "one",
          "label": "图像和 $x$ 轴只有一个公共点，就是顶点"
        }
      ],
      "answer": "one",
      "origin": {
        "node": "quadratic-function-properties",
        "item": "tangent-meaning"
      },
      "entry": "zeros"
    }
  ]
}
