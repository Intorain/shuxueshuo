    {
      "id": "linear-interval-extremum--increasing",
      "question": "$f(t)=2t-1$ 在 $[-1,3]$ 上的最大值是多少？",
      "type": "choice",
      "options": [
        {
          "value": "right",
          "label": "$5$"
        },
        {
          "value": "low",
          "label": "$-3$",
          "feedback": "$f(-1)=-3$ 是最小值。斜率 $2>0$，函数递增，右端最高。"
        },
        {
          "value": "unknown",
          "label": "不能确定",
          "feedback": "斜率确定为正，最大值就是右端点的值 $f(3)$。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "linear-interval-extremum",
        "item": "increasing"
      }
    },
    {
      "id": "linear-interval-extremum--decreasing",
      "question": "$f(t)=-3t+2$ 在 $[0,2]$ 上的最小值是多少？",
      "type": "choice",
      "options": [
        {
          "value": "left",
          "label": "$2$",
          "feedback": "$f(0)=2$ 是最大值。斜率 $-3<0$，函数递减，右端最低。"
        },
        {
          "value": "right",
          "label": "$-4$"
        },
        {
          "value": "middle",
          "label": "$-1$",
          "feedback": "$-1$ 是 $t=1$ 处的值。一次函数在闭区间上的最值在端点。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "linear-interval-extremum",
        "item": "decreasing"
      }
    },
    {
      "id": "linear-interval-extremum--constant",
      "question": "$f(t)=(m-1)t+3$，$m=1$ 时，$f(t)$ 在 $[0,2]$ 上的最小值是多少？",
      "type": "choice",
      "options": [
        {
          "value": "none",
          "label": "没有最小值",
          "feedback": "$m=1$ 时 $f(t)=3$ 是常数函数，每一点的值都是 $3$，最小值就是 $3$。"
        },
        {
          "value": "right",
          "label": "$3$"
        },
        {
          "value": "depends",
          "label": "要看 $t$ 取多少",
          "feedback": "斜率为 $0$，$f(t)$ 不随 $t$ 变化。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "linear-interval-extremum",
        "item": "constant"
      },
      "entry": "constant"
    },
    {
      "id": "linear-interval-extremum--slope-positive",
      "question": "$f(m)=(x^2+1)m-2x$ 在 $m\\in[0,2]$ 上的最小值是什么？",
      "type": "choice",
      "options": [
        {
          "value": "far",
          "label": "$2x^2-2x+2$",
          "feedback": "这是 $f(2)$，斜率 $x^2+1>0$，它是最大值。"
        },
        {
          "value": "split",
          "label": "要按 $x$ 的正负讨论",
          "feedback": "斜率 $x^2+1\\ge1>0$，不论 $x$ 取什么，$f(m)$ 都递增。"
        },
        {
          "value": "right",
          "label": "$-2x$"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "linear-interval-extremum",
        "item": "slope-positive"
      }
    }
