{
  "node": "skill-reciprocal-range",
  "items": [
    {
      "id": "amgm-formula--equal",
      "question": "$f(x)=\\sqrt{x^2+4}+\\frac1{\\sqrt{x^2+4}}$ 的最小值是多少？",
      "type": "choice",
      "options": [
        {
          "value": "two",
          "label": "$2$",
          "feedback": "取等要 $\\sqrt{x^2+4}=1$，但 $\\sqrt{x^2+4}\\ge2$，做不到。"
        },
        {
          "value": "right",
          "label": "$\\frac52$"
        },
        {
          "value": "none",
          "label": "没有最小值",
          "feedback": "令 $t=\\sqrt{x^2+4}\\ge2$，$t+\\frac1t$ 在 $[2,+\\infty)$ 上递增，$t=2$（$x=0$）时取到 $\\frac52$。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "amgm-formula",
        "item": "equal"
      }
    },
    {
      "id": "reciprocal-sum-function--min-basic",
      "question": "$y=x+\\frac9x$（$x>0$）的最小值是多少？",
      "type": "choice",
      "options": [
        {
          "value": "right",
          "label": "$6$"
        },
        {
          "value": "where",
          "label": "$3$",
          "feedback": "$3$ 是取最小值时 $x$ 的值，最小值是 $2\\sqrt9=6$。"
        },
        {
          "value": "one",
          "label": "$10$",
          "feedback": "$10$ 是 $x=1$ 时的值，不是最低点。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "reciprocal-sum-function",
        "item": "min-basic"
      }
    },
    {
      "id": "reciprocal-sum-function--interval-left",
      "question": "$y=x+\\frac4x$ 在 $[3,4]$ 上的最小值是多少？",
      "type": "choice",
      "options": [
        {
          "value": "bottom",
          "label": "$4$",
          "feedback": "$4$ 是最低点 $x=2$ 处的值，但 $x=2$ 不在 $[3,4]$ 里。区间在最低点右侧，函数递增。"
        },
        {
          "value": "right",
          "label": "$\\frac{13}3$"
        },
        {
          "value": "far",
          "label": "$5$",
          "feedback": "$f(4)=5$ 是区间上的最大值。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "reciprocal-sum-function",
        "item": "interval-left"
      }
    },
    {
      "id": "reciprocal-sum-function--interval-max",
      "question": "$y=x+\\frac4x$ 在 $[1,3]$ 上的最大值是多少？",
      "type": "choice",
      "options": [
        {
          "value": "right-end",
          "label": "$\\frac{13}3$",
          "feedback": "$f(3)=\\frac{13}3$，$f(1)=5$ 更大。两端点之积 $1\\times3<4$，左端更高。"
        },
        {
          "value": "right",
          "label": "$5$"
        },
        {
          "value": "bottom",
          "label": "$4$",
          "feedback": "$4$ 是最低点的值，是最小值。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "reciprocal-sum-function",
        "item": "interval-max"
      }
    },
    {
      "id": "reciprocal-sum-function--open-range",
      "question": "$y=x+\\frac9x$，$x\\in(1,3)$，$y$ 的取值范围是什么？",
      "type": "choice",
      "options": [
        {
          "value": "half",
          "label": "$[6,10)$",
          "feedback": "$6=f(3)$，而 $x=3$ 不在区间里，取不到。"
        },
        {
          "value": "right",
          "label": "$(6,10)$"
        },
        {
          "value": "whole",
          "label": "$[6,+\\infty)$",
          "feedback": "这是 $x>0$ 上的取值范围。在 $(1,3)$ 上函数递减，从接近 $10$ 降到接近 $6$。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "reciprocal-sum-function",
        "item": "open-range"
      }
    },
    {
      "id": "reciprocal-sum-function--negative",
      "question": "$y=x+\\frac1x$（$x<0$）的最大值是多少？",
      "type": "choice",
      "options": [
        {
          "value": "positive",
          "label": "$2$",
          "feedback": "$x<0$ 时两项都是负数，和不可能是 $2$。"
        },
        {
          "value": "none",
          "label": "没有最大值",
          "feedback": "$x<0$ 的部分和 $x>0$ 的部分关于原点对称，有最高点 $(-1,-2)$。"
        },
        {
          "value": "right",
          "label": "$-2$"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "reciprocal-sum-function",
        "item": "negative"
      }
    },
    {
      "id": "reciprocal-sum-function--transform",
      "question": "$h(x)=-x-\\frac8x$（$x<0$）的最小值是多少？",
      "type": "choice",
      "options": [
        {
          "value": "sign",
          "label": "$-4\\sqrt2$",
          "feedback": "$-x>0$，$h(x)=(-x)+\\frac8{-x}$ 是两个正数的和，最小值是正数。"
        },
        {
          "value": "right",
          "label": "$4\\sqrt2$"
        },
        {
          "value": "half",
          "label": "$2\\sqrt2$",
          "feedback": "最小值是 $2\\sqrt k=2\\sqrt8=4\\sqrt2$。"
        }
      ],
      "answer": "right",
      "origin": {
        "node": "reciprocal-sum-function",
        "item": "transform"
      }
    }
  ]
}
