{
  "node": "method-substitution",
  "items": [
    {
      "id": "rewrite",
      "given": "$x>1$，求 $\\frac{x^2-x+1}{x-1}$ 的最小值。",
      "question": "令 $t=x-1$，式子变成什么？",
      "type": "choice",
      "options": [
        {"value": "right", "label": "$t+\\frac1t+1$"},
        {"value": "missing", "label": "$t+\\frac1t$", "feedback": "$x=t+1$，分子 $=t^2+t+1$，除以 $t$ 得 $t+1+\\frac1t$。"},
        {"value": "numer", "label": "$t^2+t+1$", "feedback": "这只是分子，还要除以分母 $t$。"}
      ],
      "answer": "right"
    },
    {
      "id": "min",
      "given": "$x>1$。",
      "question": "$\\frac{x^2-x+1}{x-1}$ 的最小值是多少？",
      "type": "choice",
      "options": [
        {"value": "two", "label": "$2$", "feedback": "$t+\\frac1t\\ge2$，原式还要加 $1$。"},
        {"value": "one", "label": "$1$", "feedback": "$t=1$ 是取等时的值，此时 $x=2$，原式为 $3$。"},
        {"value": "right", "label": "$3$"}
      ],
      "answer": "right"
    },
    {
      "id": "range",
      "question": "$x\\in(1,3)$，令 $t=x-1$，$t$ 的取值范围是什么？",
      "type": "choice",
      "options": [
        {"value": "pos", "label": "$t>0$", "feedback": "$x<3$ 还给出 $t<2$。换元后要写出新变量的完整范围。"},
        {"value": "right", "label": "$t\\in(0,2)$"},
        {"value": "same", "label": "$t\\in(1,3)$", "feedback": "这是 $x$ 的范围，$t=x-1$ 要整体减 $1$。"}
      ],
      "answer": "right"
    },
    {
      "id": "compute",
      "question": "$x>-1$ 时，$\\frac{x^2+3}{x+1}$ 的最小值是多少？",
      "type": "choice",
      "options": [
        {"value": "right", "label": "$2$"},
        {"value": "four", "label": "$4$", "feedback": "令 $t=x+1$，原式 $=t+\\frac4t-2\\ge4-2$，别漏 $-2$。"},
        {"value": "three", "label": "$3$", "feedback": "$3$ 是 $x=0$ 时的值。取等要 $t=2$，即 $x=1$，值为 $2$。"}
      ],
      "answer": "right"
    },
    {
      "id": "when",
      "question": "什么时候想到换元？",
      "type": "choice",
      "options": [
        {"value": "one-var", "label": "只要式子里只有一个变量", "feedback": "关键是有一个反复出现的整体，例如分母 $x-1$、$x+y$。"},
        {"value": "right", "label": "式子里有一个整体（如分母 $x-1$、$x+y$），把它当新变量更简单"},
        {"value": "no-range", "label": "想简化式子时，换元后不用管范围", "feedback": "新变量的范围决定了等号能不能取到，必须写出来。"}
      ],
      "answer": "right"
    }
  ]
}
