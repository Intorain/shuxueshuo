                "variable": "$x",
                "domain": "$domain"
              },
              "outputs": {
                "linear_range": "range"
              },
              "order": 2,
              "rule_ref": "rule-interval-skill",
              "branch": "linear",
              "guard": {
                "all": [
                  {
                    "ref": "skill_choice",
                    "equals": "linear"
                  },
                  {
                    "ref": "interval_mode",
                    "equals": "linear"
                  }
                ]
              },
              "skip_reason": "not_selected"
            },
            {
              "id": "reciprocal",
              "capability": "reciprocal_range",
              "public_ref": "skill-reciprocal-range",
              "inputs": {},
              "outputs": {},
              "order": 3,
              "rule_ref": "rule-interval-skill",
              "branch": "reciprocal",
              "guard": {
                "ref": "skill_choice",
                "equals": "reciprocal"
              },
              "skip_reason": "not_selected"
            },
            {
              "id": "classified",
              "capability": "parametric_interval_extremum",
              "public_ref": "quadratic-interval-extremum",
              "inputs": {
                "expression": "$interval_function",
                "variable": "$x",
                "parameter": "$parameter",
                "domain": "$domain",
                "policy": "$policy",
                "case": "$case"
              },
              "outputs": {
                "classified_range": "range",
                "case_vertex": "vertex",
                "case_coefficient": "coefficient"
              },
              "order": 4,
              "rule_ref": "rule-interval-skill",
              "branch": "quadratic",
              "guard": {
                "all": [
                  {
                    "ref": "skill_choice",
                    "equals": "quadratic"
                  },
                  {
                    "ref": "interval_mode",
                    "equals": "classified"
                  }
                ]
              },
              "skip_reason": "not_selected"
            }
          ],
          "judgments": [
            {
              "id": "skill",
              "function": "interval_case_skill",
              "rule_ref": "rule-interval-skill",
              "inputs": {
                "expression": "$interval_function",
                "variable": "$x",
                "parameter": "$parameter",
                "case": "$case"
              },
              "outputs": {
                "skill_choice": "choice",
                "interval_mode": "mode",
                "case_expression": "expression"
              },
              "options": [
                {
                  "id": "quadratic"
                },
                {
                  "id": "linear"
                },
                {
                  "id": "reciprocal"
                }
              ],
              "order": -1,
              "depends_on": [
                "case",
                "interval_function",
                "parameter",
                "x"
              ]
            }
          ],
          "display_units": [
            {
              "id": "endpoint_bounds",
              "after": "endpoints",
              "template": "endpoint_bounds",
              "bindings": {
                "before": [
                  "$interval_function"
                ],
                "after": [],
                "range": "$endpoint_range",
                "function": "$interval_function",
                "x": "$x",
                "domain": "$domain",
                "function_name": "$function_name"
              },
              "depends_on": [
                "domain",
                "endpoint_range",
                "function_name",
                "interval_function",
                "x"
              ],
              "guard": {
                "all": [
                  {
                    "ref": "skill_choice",
                    "equals": "quadratic"
                  },
                  {
                    "ref": "interval_mode",
                    "equals": "endpoint"
                  }
                ]
              }
            },
            {
              "id": "numeric_range",
              "after": "numeric",
              "template": "numeric_range",
              "bindings": {
                "before": [
                  "$interval_function"
                ],
                "after": [
                  "$numeric_range.set"
                ],
                "range": "$numeric_range",
                "function": "$interval_function",
                "x": "$x",
                "domain": "$domain",
                "function_name": "$function_name"
              },
              "depends_on": [
                "domain",
                "function_name",
                "interval_function",
                "numeric_range",
                "x"
              ],
              "guard": {
                "all": [
                  {
                    "ref": "skill_choice",
                    "equals": "quadratic"
                  },
                  {
                    "ref": "interval_mode",
                    "equals": "numeric"
                  }
                ]
              }
            },
            {
              "id": "classified_range",
              "after": "classified",
              "template": "classified_range",
              "bindings": {
                "before": [
                  "$interval_function"
                ],
                "after": [],
                "range": "$classified_range",
                "condition": "$case.condition",
                "vertex": "$case_vertex",
                "coefficient": "$case_coefficient",
                "x": "$x",
                "domain": "$domain",
                "function_name": "$function_name"
              },
              "depends_on": [
                "case",
                "case_coefficient",
                "case_vertex",
                "classified_range",
                "domain",
                "function_name",
                "interval_function",
                "x"
              ],
              "guard": {
                "all": [
                  {
                    "ref": "skill_choice",
                    "equals": "quadratic"
                  },
                  {
                    "ref": "interval_mode",
                    "equals": "classified"
                  }
                ]
              }
            },
            {
              "id": "linear_range",
              "after": "linear",
              "template": "case_linear_range",
              "bindings": {
                "before": [
                  "$case_expression"
                ],
                "after": [
                  "$linear_range.set"
                ],
                "range": "$linear_range",
                "condition": "$case.condition",
                "kind": "$case.kind",
                "domain": "$domain",
                "x": "$x",
                "function_name": "$function_name"
              },
              "depends_on": [
                "case",
                "case_expression",
                "domain",
                "function_name",
                "linear_range",
                "x"
              ],
              "guard": {
                "all": [
                  {
                    "ref": "skill_choice",
                    "equals": "linear"
                  },
                  {
                    "ref": "interval_mode",
                    "equals": "linear"
                  }
                ]
              }
            }
          ],
          "merges": [
            {
              "id": "range_result",
              "order": 5,
              "branches": [
                {
                  "guard": {
                    "all": [
                      {
                        "ref": "skill_choice",
                        "equals": "quadratic"
                      },
                      {
                        "ref": "interval_mode",
                        "equals": "endpoint"
                      }
                    ]
                  },
                  "bindings": {
                    "function_range": "$endpoint_range"
                  }
                },
                {
                  "guard": {
                    "all": [
                      {
                        "ref": "skill_choice",
                        "equals": "quadratic"
                      },
                      {
                        "ref": "interval_mode",
                        "equals": "numeric"
                      }
                    ]
                  },
                  "bindings": {
                    "function_range": "$numeric_range"
                  }
                },
                {
                  "guard": {
                    "all": [
                      {
                        "ref": "skill_choice",
                        "equals": "quadratic"
                      },
                      {
                        "ref": "interval_mode",
                        "equals": "classified"
                      }
                    ]
                  },
                  "bindings": {
                    "function_range": "$classified_range"
                  }
                },
                {
                  "guard": {
                    "all": [
                      {
                        "ref": "skill_choice",
                        "equals": "linear"
                      },
                      {
                        "ref": "interval_mode",
                        "equals": "linear"
                      }
                    ]
                  },
                  "bindings": {
                    "function_range": "$linear_range"
                  }
                }
              ]
            }
          ],
          "id": "select"
        }
      }
    },
    {
      "id": "conditions",
      "calls": [
        {
          "id": "apply",
          "capability": "apply_quantifier_policy",
          "public_ref": null,
          "inputs": {
            "policy": "$policy",
            "range": "$function_range",
            "parameter_expression": "$zero"
          },
          "outputs": {
            "conditions": "conditions",
            "combiner": "combiner"
          },
          "order": 0
        },
        {
          "id": "solve",
          "capability": "solve_interval_conditions",
          "public_ref": "skill-inequality-transform",
          "inputs": {
            "conditions": "$conditions",
            "combiner": "$combiner",
            "variable": "$parameter",
            "case_domain": "$case.domain"
          },
          "outputs": {
            "case_solution": "solution",
            "condition_sets": "solutions"
          },
          "order": 1
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "conditions",
          "after": "solve",
          "template": "interval_conditions",
          "bindings": {
            "before": [],
            "after": [
              "$case_solution"
            ],
            "conditions": "$conditions",
            "combiner": "$combiner",
            "solutions": "$condition_sets",
            "condition": "$case.condition"
          },
          "depends_on": [
            "case",
            "case_solution",
            "combiner",
            "condition_sets",
            "conditions"
          ]
        }
      ]
    },
    {
      "id": "verify",
      "judgments": [],
      "calls": [
        {
          "id": "merge",
          "capability": "merge_interval_cases",
          "public_ref": null,
          "inputs": {
            "cases": "$interval_cases",
            "results": "$interval_case_results"
          },
          "outputs": {
            "candidate_set": "solution",
            "case_solutions": "case_solutions"
          },
          "order": 0
        }
      ],
      "display_units": [
        {
          "id": "interval_merge",
          "after": "merge",
          "template": "interval_merge",
          "bindings": {
            "before": [
              "$interval_function"
            ],
            "after": [
              "$candidate_set"
            ],
            "cases": "$interval_cases",
            "solutions": "$case_solutions",
            "results": "$interval_case_results",
            "function_name": "$function_name",
            "x": "$x"
          },
          "depends_on": [
            "candidate_set",
            "case_solutions",
            "function_name",
            "interval_case_results",
            "interval_cases",
            "interval_function",
            "x"
          ],
          "guard": {
            "ref": "has_cases",
            "equals": true
          }
        }
      ]
    }
  ],
  "outputs": {
    "candidate_set": "$candidate_set"
  },
  "exits": {
    "capability_gap": {
      "status": "capability_gap"
    },
    "math_failed": {
      "status": "math_failed"
    },
    "execution_error": {
      "status": "execution_error"
    }
  },
  "admission": {
    "bindings": {
      "interval_function": {
        "resolver": "interval_function"
      },
      "interval_operator": {
        "resolver": "interval_operator"
      },
      "x": {
        "resolver": "bound_variable"
      },
      "parameter": {
        "resolver": "parameter"
      },
      "domain": {
        "resolver": "domain"
      },
      "quantifier": {
        "resolver": "quantifier"
      },
      "zero": {
        "resolver": "zero"
      },
      "constraint_context": {
        "resolver": "constraint_context"
      },
      "goal": {
        "resolver": "goal"
      },
      "function_name": {
        "constant": "g"
      }
    },
    "checks": [
      {
        "function": "quantifier",
        "inputs": {
          "quantifier": "$quantifier"
        }
      },
      {
        "function": "polynomial_degree",
        "inputs": {
          "expression": "$interval_function",
          "variable": "$x",
          "degree": 2
        }
      },
      {
        "function": "interval_cases",
        "inputs": {
          "expression": "$interval_function",
          "variable": "$x",
          "parameter": "$parameter",
          "domain": "$domain",
          "quantifier": "$quantifier",
          "operator": "$interval_operator"
        }
      }
    ]
  }
}
