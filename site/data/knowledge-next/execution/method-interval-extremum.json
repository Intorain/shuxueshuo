{
  "schema_version": "graph-method-execution/v1",
  "method": "method-interval-extremum",
  "inputs": {
    "interval_function": {
      "role": "interval_function"
    },
    "interval_operator": {
      "role": "interval_operator"
    },
    "x": {
      "role": "x"
    },
    "parameter": {
      "role": "parameter"
    },
    "domain": {
      "role": "domain"
    },
    "quantifier": {
      "role": "quantifier"
    },
    "zero": {
      "role": "zero"
    },
    "constraint_context": {
      "role": "constraint_context"
    },
    "goal": {
      "role": "goal"
    },
    "function_name": {
      "role": "function_name"
    }
  },
  "steps": [
    {
      "id": "quantifier",
      "calls": [
        {
          "id": "policy",
          "capability": "select_quantifier_policy",
          "public_ref": "skill-quantified-range",
          "inputs": {
            "quantifier": "$quantifier",
            "operator": "$interval_operator",
            "domain": "$domain"
          },
          "outputs": {
            "policy": "policy"
          },
          "order": 0
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "policy",
          "after": "policy",
          "template": "policy",
          "bindings": {
            "before": [
              "$interval_function"
            ],
            "after": [],
            "policy": "$policy",
            "x": "$x",
            "parameter_expression": "$zero",
            "function": "$interval_function",
            "domain": "$domain",
            "function_name": "$function_name",
            "define_name": true
          },
          "depends_on": [
            "domain",
            "function_name",
            "interval_function",
            "policy",
            "x",
            "zero"
          ]
        }
      ]
    },
    {
      "id": "select",
      "calls": [],
      "judgments": [
        {
          "id": "plan",
          "function": "interval_case_plan",
          "inputs": {
            "expression": "$interval_function",
            "variable": "$x",
            "parameter": "$parameter",
            "domain": "$domain",
            "policy": "$policy"
          },
          "outputs": {
            "interval_cases": "cases",
            "has_cases": "has_cases"
          },
          "options": [
            {
              "id": "direct"
            },
            {
              "id": "classified"
            }
          ],
          "order": 0,
          "depends_on": [
            "domain",
            "interval_function",
            "parameter",
            "policy",
            "x"
          ]
        }
      ],
      "display_units": [
        {
          "id": "interval_cases",
          "after": "plan",
          "template": "interval_cases",
          "bindings": {
            "before": [
              "$interval_function"
            ],
            "after": [],
            "cases": "$interval_cases",
            "parameter": "$parameter",
            "function_name": "$function_name",
            "x": "$x",
            "domain": "$domain"
          },
          "depends_on": [
            "domain",
            "function_name",
            "interval_cases",
            "interval_function",
            "parameter",
            "x"
          ],
          "guard": {
            "ref": "has_cases",
            "equals": true
          }
        }
      ],
      "cases": {
        "source": "interval_cases",
        "binding": "case",
        "through": "conditions",
        "collect": "interval_case_results",
        "outputs": {
          "solution": "$case_solution",
          "conditions": "$conditions",
          "combiner": "$combiner",
          "condition_sets": "$condition_sets"
        },
        "entry": {
          "calls": [
            {
              "id": "endpoints",
              "capability": "endpoint_values_extremum",
              "public_ref": "quadratic-interval-extremum",
              "inputs": {
                "expression": "$interval_function",
                "variable": "$x",
                "parameter": "$parameter",
                "domain": "$domain",
                "policy": "$policy"
              },
              "outputs": {
                "endpoint_range": "range",
                "endpoint_values": "endpoint_values"
              },
              "order": 0,
              "rule_ref": "rule-interval-skill",
              "branch": "quadratic",
              "guard": {
                "all": [
                  {
                    "ref": "skill_choice",
                    "equals": "quadratic"
                  },
                  {
                    "ref": "interval_mode",
                    "equals": "endpoint"
                  }
                ]
              },
              "skip_reason": "not_selected"
            },
            {
              "id": "numeric",
              "capability": "quadratic_interval_range",
              "public_ref": "quadratic-interval-extremum",
              "inputs": {
                "expression": "$interval_function",
                "variable": "$x",
                "domain": "$domain"
              },
              "outputs": {
                "numeric_range": "range"
              },
              "order": 1,
              "rule_ref": "rule-interval-skill",
              "branch": "quadratic",
              "guard": {
                "all": [
                  {
                    "ref": "skill_choice",
                    "equals": "quadratic"
                  },
                  {
                    "ref": "interval_mode",
                    "equals": "numeric"
                  }
                ]
              },
              "skip_reason": "not_selected"
            },
            {
              "id": "linear",
              "capability": "linear_range",
              "public_ref": "skill-linear-range",
