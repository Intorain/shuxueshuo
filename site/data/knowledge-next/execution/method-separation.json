{
  "method": "method-separation",
  "inputs": {
    "relation": {
      "role": "relation"
    },
    "expression": {
      "role": "expression"
    },
    "x": {
      "role": "x"
    },
    "parameter": {
      "role": "parameter"
    },
    "domain": {
      "role": "domain"
    },
    "quantifier": {
      "role": "quantifier"
    },
    "strict": {
      "role": "strict"
    },
    "goal": {
      "role": "goal"
    },
    "constraint_context": {
      "role": "constraint_context"
    },
    "relation_kind": {
      "role": "relation_kind"
    }
  },
  "steps": [
    {
      "id": "separate",
      "calls": [
        {
          "id": "inspect",
          "capability": "separate_parameter",
          "public_ref": null,
          "inputs": {
            "relation": "$relation",
            "parameter": "$parameter",
            "variable": "$x",
            "domain": "$domain"
          },
          "outputs": {
            "separation_candidate": "candidate",
            "already_separated": "already_separated"
          },
          "order": -1
        },
        {
          "id": "inequality",
          "capability": "separation_division",
          "public_ref": "skill-inequality-transform",
          "inputs": {
            "relation": "$relation",
            "parameter": "$parameter",
            "variable": "$x",
            "domain": "$domain",
            "prepared": "$separation_candidate"
          },
          "outputs": {
            "applied_separation": "candidate"
          },
          "guard": {
            "ref": "already_separated",
            "equals": false
          },
          "skip_reason": "already_satisfied",
          "order": 0
        },
        {
          "id": "equality",
          "capability": "separation_division",
          "public_ref": "skill-equality-transform",
          "inputs": {
            "relation": "$relation",
            "parameter": "$parameter",
            "variable": "$x",
            "domain": "$domain"
          },
          "outputs": {},
          "guard": {
            "ref": "relation_kind",
            "equals": "equality"
          },
          "skip_reason": "not_applicable",
          "order": 1
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "separated",
          "after": "inspect",
          "template": "separated",
          "bindings": {
            "before": [
              "$relation"
            ],
            "after": [
              "$separation_candidate.separated_relation"
            ]
          },
          "depends_on": [
            "relation",
            "separation_candidate"
          ],
          "guard": {
            "ref": "already_separated",
            "equals": true
          }
        },
        {
          "id": "divided",
          "after": "inequality",
          "template": "divided",
          "bindings": {
            "before": [
              "$relation"
            ],
            "after": [
              "$applied_separation.separated_relation"
            ],
            "divisor": "$applied_separation.divisor"
          },
          "depends_on": [
            "applied_separation",
            "relation"
          ],
          "guard": {
            "ref": "applied_separation.transformation",
            "equals": "positive_division"
          }
        },
        {
          "id": "moved",
          "after": "inequality",
          "template": "moved",
          "bindings": {
            "before": [
              "$relation"
            ],
            "after": [
              "$applied_separation.separated_relation"
            ]
          },
          "depends_on": [
            "applied_separation",
            "relation"
          ],
          "guard": {
            "ref": "applied_separation.transformation",
            "equals": "move_terms"
          }
        }
      ],
      "merges": [
        {
          "id": "separation_result",
          "order": 2,
          "branches": [
            {
              "guard": {
                "ref": "already_separated",
                "equals": true
              },
              "bindings": {
                "parameter_expression": "$separation_candidate.parameter_expression",
                "function": "$separation_candidate.function",
                "operator": "$separation_candidate.operator",
                "separated_relation": "$separation_candidate.separated_relation"
              }
            },
            {
              "guard": {
                "ref": "already_separated",
                "equals": false
              },
              "bindings": {
                "parameter_expression": "$applied_separation.parameter_expression",
                "function": "$applied_separation.function",
                "operator": "$applied_separation.operator",
                "separated_relation": "$applied_separation.separated_relation"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "quantifier",
      "calls": [
        {
          "id": "policy",
          "capability": "select_quantifier_policy",
          "public_ref": "skill-quantified-range",
          "inputs": {
            "quantifier": "$quantifier",
            "operator": "$operator",
            "domain": "$domain"
          },
          "outputs": {
            "policy": "policy"
          },
          "order": 0
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "policy",
          "after": "policy",
          "template": "policy",
          "bindings": {
            "before": [],
            "after": [],
            "policy": "$policy",
            "x": "$x",
            "parameter_expression": "$parameter_expression",
            "function": "$function"
          },
          "depends_on": [
            "function",
            "parameter_expression",
            "policy",
            "x"
          ]
        }
      ]
    },
    {
      "id": "range",
      "calls": [
        {
          "id": "interval",
          "capability": "quadratic_interval_range",
          "public_ref": "quadratic-interval-extremum",
          "inputs": {
            "expression": "$function",
            "variable": "$x",
            "domain": "$domain"
          },
          "outputs": {
            "interval_range": "range"
          },
          "guard": {
            "ref": "range_choice",
            "equals": "interval"
          },
          "skip_reason": "not_selected",
          "order": 0
        },
        {
          "id": "linear",
          "capability": "linear_range",
          "public_ref": "skill-linear-range",
          "inputs": {},
          "outputs": {},
          "guard": {
            "ref": "range_choice",
            "equals": "linear"
          },
          "skip_reason": "not_selected",
          "order": 1
        },
        {
          "id": "reciprocal",
          "capability": "reciprocal_range",
          "public_ref": "skill-reciprocal-range",
          "inputs": {
            "expression": "$function",
            "variable": "$x",
            "domain": "$domain"
          },
          "outputs": {
            "reciprocal_range": "range"
          },
          "guard": {
            "ref": "range_choice",
            "equals": "reciprocal"
          },
          "skip_reason": "not_selected",
          "order": 2
        },
        {
          "id": "square",
          "capability": "submethod",
          "public_ref": "method-square-extremum",
          "inputs": {
            "expression": "$function",
            "variable": "$x",
            "domain": "$domain"
          },
          "outputs": {
            "square_function_range": "range",
            "square_square": "square",
            "square_vertex": "vertex",
            "square_extremum": "value"
          },
          "order": 3,
          "guard": {
            "ref": "range_choice",
            "equals": "square"
          },
          "skip_reason": "not_selected"
        }
      ],
      "judgments": [
        {
          "id": "range_skill",
          "function": "range_skill",
          "inputs": {
            "expression": "$function",
            "variable": "$x",
            "domain": "$domain"
          },
          "outputs": {
            "range_choice": "choice"
          },
          "options": [
            {
              "id": "square"
            },
            {
              "id": "interval"
            },
            {
              "id": "linear"
            },
            {
              "id": "reciprocal"
            }
          ],
          "order": -1,
          "depends_on": [
            "domain",
            "function",
            "x"
          ]
        }
      ],
      "display_units": [
        {
          "id": "range",
          "after": "square",
          "template": "square_range",
          "bindings": {
            "before": [
              "$function"
            ],
            "after": [
              "$square_square",
              "$square_extremum"
            ],
            "function": "$function",
            "square": "$square_square",
            "x": "$x",
            "vertex": "$square_vertex",
            "extremum": "$square_extremum"
          },
          "depends_on": [
            "function",
            "square_extremum",
            "square_square",
            "square_vertex",
            "x"
          ],
          "guard": {
            "ref": "range_choice",
            "equals": "square"
          }
        },
        {
          "id": "interval_range",
          "after": "interval",
          "template": "numeric_range",
          "bindings": {
            "before": [
              "$function"
            ],
            "after": [
              "$interval_range.set"
            ],
            "range": "$interval_range",
            "domain": "$domain",
            "function": "$function",
            "x": "$x"
          },
          "depends_on": [
            "domain",
            "function",
            "interval_range",
            "x"
          ],
          "guard": {
            "ref": "range_choice",
            "equals": "interval"
          }
        },
        {
          "id": "reciprocal_range",
          "after": "reciprocal",
          "template": "numeric_range",
          "bindings": {
            "before": [
              "$function"
            ],
            "after": [
              "$reciprocal_range.set"
            ],
            "range": "$reciprocal_range",
            "domain": "$domain",
            "function": "$function",
            "x": "$x"
          },
          "depends_on": [
            "domain",
            "function",
            "reciprocal_range",
            "x"
          ],
          "guard": {
            "ref": "range_choice",
            "equals": "reciprocal"
          }
        }
      ],
      "merges": [
        {
          "id": "range_result",
          "order": 4,
          "branches": [
            {
              "guard": {
                "ref": "range_choice",
                "equals": "square"
              },
              "bindings": {
                "function_range": "$square_function_range"
              }
            },
            {
              "guard": {
                "ref": "range_choice",
                "equals": "interval"
              },
              "bindings": {
                "function_range": "$interval_range"
              }
            },
            {
              "guard": {
                "ref": "range_choice",
                "equals": "reciprocal"
              },
              "bindings": {
                "function_range": "$reciprocal_range"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "restore",
      "calls": [
        {
          "id": "apply",
          "capability": "apply_quantifier_policy",
          "public_ref": null,
          "inputs": {
            "policy": "$policy",
            "range": "$function_range",
            "parameter_expression": "$parameter_expression"
          },
          "outputs": {
            "original_condition": "condition"
          },
          "order": 0
        },
        {
          "id": "transform",
          "capability": "normalize_to_zero",
          "public_ref": "skill-inequality-transform",
          "inputs": {
            "relation": "$original_condition",
            "variable": "$parameter"
          },
          "outputs": {
            "parameter_condition": "relation",
            "parameter_polynomial": "expression"
          },
          "order": 1
        },
        {
          "id": "solve",
          "capability": "submethod",
          "public_ref": "quadratic-inequality-solve",
          "inputs": {
            "relation": "$parameter_condition",
            "variable": "$parameter"
          },
          "outputs": {
            "candidate_set": "solution"
          },
          "order": 2
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "solution",
          "after": "solve",
          "template": "solution",
          "bindings": {
            "before": [
              "$original_condition"
            ],
            "after": [
              "$parameter_condition",
              "$candidate_set"
            ]
          },
          "depends_on": [
            "candidate_set",
            "original_condition",
            "parameter_condition"
          ]
        }
      ]
    }
  ],
  "outputs": {
    "candidate_set": "$candidate_set"
  },
  "exits": {
    "capability_gap": {
      "status": "capability_gap"
    },
    "math_failed": {
      "status": "math_failed"
    },
    "execution_error": {
      "status": "execution_error"
    }
  },
  "schema_version": "graph-method-execution/v1"
}
