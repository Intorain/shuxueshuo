{
  "schema_version": "graph-method-execution/v1",
  "method": "method-variable-swap",
  "inputs": {
    "interval_function": {
      "role": "interval_function"
    },
    "interval_operator": {
      "role": "interval_operator"
    },
    "x": {
      "role": "x"
    },
    "parameter": {
      "role": "parameter"
    },
    "domain": {
      "role": "domain"
    },
    "quantifier": {
      "role": "quantifier"
    },
    "zero": {
      "role": "zero"
    }
  },
  "steps": [
    {
      "id": "roles",
      "calls": [],
      "judgments": [
        {
          "id": "identify",
          "function": "variable_roles",
          "inputs": {
            "variable": "$x",
            "parameter": "$parameter",
            "domain": "$domain",
            "quantifier": "$quantifier"
          },
          "outputs": {},
          "options": [
            {
              "id": "identified"
            }
          ],
          "order": 0,
          "depends_on": [
            "domain",
            "parameter",
            "quantifier",
            "x"
          ]
        }
      ],
      "display_units": [
        {
          "id": "roles",
          "after": "identify",
          "template": "variable_roles",
          "bindings": {
            "before": [],
            "after": [],
            "x": "$x",
            "parameter": "$parameter",
            "domain": "$domain",
            "quantifier": "$quantifier"
          },
          "depends_on": [
            "domain",
            "parameter",
            "quantifier",
            "x"
          ]
        }
      ]
    },
    {
      "id": "reorder",
      "calls": [
        {
          "id": "collect",
          "capability": "reorder_by_variable",
          "public_ref": "skill-simplify",
          "inputs": {
            "expression": "$interval_function",
            "variable": "$x",
            "parameter": "$parameter"
          },
          "outputs": {
            "collected": "expression",
            "slope": "slope",
            "intercept": "intercept"
          },
          "order": 0
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "reorder",
          "after": "collect",
          "template": "variable_reorder",
          "bindings": {
            "before": [
              "$interval_function"
            ],
            "after": [
              "$collected"
            ],
            "x": "$x",
            "slope": "$slope",
            "intercept": "$intercept"
          },
          "depends_on": [
            "collected",
            "intercept",
            "interval_function",
            "slope",
            "x"
          ]
        }
      ]
    },
    {
      "id": "quantifier",
      "calls": [
        {
          "id": "policy",
          "capability": "select_quantifier_policy",
          "public_ref": "skill-quantified-range",
          "inputs": {
            "quantifier": "$quantifier",
            "operator": "$interval_operator",
            "domain": "$domain"
          },
          "outputs": {
            "policy": "policy"
          },
          "order": 0
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "policy",
          "after": "policy",
          "template": "policy",
          "bindings": {
            "before": [
              "$collected"
            ],
            "after": [],
            "policy": "$policy",
            "x": "$x",
            "parameter_expression": "$zero",
            "function": "$collected",
            "domain": "$domain",
            "function_name": "",
            "define_name": false
          },
          "depends_on": [
            "collected",
            "domain",
            "policy",
            "x",
            "zero"
          ]
        }
      ]
    },
    {
      "id": "range",
      "calls": [],
      "judgments": [
        {
          "id": "plan",
          "function": "variable_case_plan",
          "inputs": {
            "expression": "$collected",
            "variable": "$x",
            "parameter": "$parameter",
            "domain": "$domain",
            "policy": "$policy"
          },
          "outputs": {
            "variable_cases": "cases",
            "has_cases": "has_cases"
          },
          "options": [
            {
              "id": "direct"
            },
            {
              "id": "classified"
            }
          ],
          "order": 0,
          "depends_on": [
            "collected",
            "domain",
            "parameter",
            "policy",
            "x"
          ]
        }
      ],
      "display_units": [
        {
          "id": "variable_cases",
          "after": "plan",
          "template": "variable_cases",
          "bindings": {
            "before": [
              "$collected"
            ],
            "after": [],
            "cases": "$variable_cases",
            "parameter": "$parameter",
            "slope": "$slope"
          },
          "depends_on": [
            "collected",
            "parameter",
            "slope",
            "variable_cases"
          ],
          "guard": {
            "ref": "has_cases",
            "equals": true
          }
        }
      ],
      "cases": {
        "source": "variable_cases",
        "binding": "case",
        "through": "solve",
        "collect": "variable_case_results",
        "outputs": {
          "solution": "$case_solution"
        },
        "entry": {
          "id": "range",
          "calls": [
            {
              "id": "linear",
              "capability": "parameter_linear_case_range",
              "public_ref": "skill-linear-range",
              "inputs": {
                "expression": "$collected",
                "variable": "$x",
                "parameter": "$parameter",
                "domain": "$domain",
                "policy": "$policy",
                "case": "$case"
              },
              "outputs": {
                "function_range": "range",
                "slope_sign": "slope_sign",
                "endpoint_mode": "endpoint_mode",
                "slope_certificate": "slope_certificate"
              },
              "order": 0
            }
          ],
          "judgments": [
            {
              "id": "sign",
              "function": "affine_slope_decision",
              "inputs": {
                "certificate": "$slope_certificate"
              },
              "outputs": {},
              "options": [
                {
                  "id": "positive"
                },
                {
                  "id": "negative"
                },
                {
                  "id": "zero"
                },
                {
                  "id": "unknown"
                }
              ],
              "order": 1,
              "depends_on": [
                "slope_certificate"
              ]
            }
          ],
          "display_units": [
            {
              "id": "range",
              "after": "sign",
              "template": "variable_range",
              "bindings": {
                "before": [
                  "$collected"
                ],
                "after": [],
                "x": "$x",
                "parameter": "$parameter",
                "domain": "$domain",
                "slope": "$slope",
                "slope_sign": "$slope_sign",
                "endpoint_mode": "$endpoint_mode",
                "range": "$function_range",
                "slope_certificate": "$slope_certificate"
              },
              "depends_on": [
                "collected",
                "domain",
                "endpoint_mode",
                "function_range",
                "parameter",
                "slope",
                "slope_sign",
                "x",
                "slope_certificate"
              ],
              "guard": {
                "ref": "has_cases",
                "equals": false
              }
            },
            {
              "id": "case_range",
              "after": "sign",
              "template": "variable_case_range",
              "bindings": {
                "before": [
                  "$collected"
                ],
                "after": [],
                "x": "$x",
                "parameter": "$parameter",
                "domain": "$domain",
                "slope": "$slope",
                "slope_sign": "$slope_sign",
                "endpoint_mode": "$endpoint_mode",
                "range": "$function_range",
                "slope_certificate": "$slope_certificate",
                "condition": "$case.condition"
              },
              "depends_on": [
                "case",
                "collected",
                "domain",
                "endpoint_mode",
                "function_range",
                "parameter",
                "slope",
                "slope_certificate",
                "slope_sign",
                "x"
              ],
              "guard": {
                "ref": "has_cases",
                "equals": true
              }
            }
          ]
        }
      }
    },
    {
      "id": "solve",
      "calls": [
        {
          "id": "apply",
          "capability": "apply_quantifier_policy",
          "public_ref": null,
          "inputs": {
            "policy": "$policy",
            "range": "$function_range",
            "parameter_expression": "$zero"
          },
          "outputs": {
            "conditions": "conditions",
            "combiner": "combiner"
          },
          "order": 0
        },
        {
          "id": "normalize",
          "capability": "normalize_parameter_conditions",
          "public_ref": "skill-inequality-transform",
          "inputs": {
            "conditions": "$conditions",
            "variable": "$parameter"
          },
          "outputs": {
            "normalized_conditions": "conditions"
          },
          "order": 1
        },
        {
          "id": "first_quadratic",
          "capability": "submethod",
          "public_ref": "quadratic-inequality-solve",
          "inputs": {
            "relation": "$first_condition",
            "variable": "$parameter"
          },
          "outputs": {
            "first_quadratic_solution": "solution"
          },
          "order": 3,
          "guard": {
            "ref": "first_kind",
            "equals": "quadratic"
          },
          "skip_reason": "not_selected"
        },
        {
          "id": "first_affine",
          "capability": "solve_affine_condition",
          "public_ref": null,
          "inputs": {
            "condition": "$first_condition",
            "variable": "$parameter"
          },
          "outputs": {
            "first_affine_solution": "solution"
          },
          "order": 4,
          "guard": {
            "ref": "first_kind",
            "equals": "affine"
          },
          "skip_reason": "not_selected"
        },
        {
          "id": "second_quadratic",
          "capability": "submethod",
          "public_ref": "quadratic-inequality-solve",
          "inputs": {
            "relation": "$second_condition",
            "variable": "$parameter"
          },
          "outputs": {
            "second_quadratic_solution": "solution"
          },
          "order": 6,
          "guard": {
            "ref": "second_kind",
            "equals": "quadratic"
          },
          "skip_reason": "not_selected"
        },
        {
          "id": "second_affine",
          "capability": "solve_affine_condition",
          "public_ref": null,
          "inputs": {
            "condition": "$second_condition",
            "variable": "$parameter"
          },
          "outputs": {
            "second_affine_solution": "solution"
          },
          "order": 7,
          "guard": {
            "ref": "second_kind",
            "equals": "affine"
          },
          "skip_reason": "not_selected"
        },
        {
          "id": "combine",
          "capability": "combine_variable_solutions",
          "public_ref": null,
          "inputs": {
            "conditions": "$normalized_conditions",
            "first": "$first_solution",
            "second": "$second_solution",
            "combiner": "$combiner",
            "variable": "$parameter"
          },
          "outputs": {
            "candidate_set": "solution",
            "condition_sets": "solutions"
          },
          "order": 9
        },
        {
          "id": "intersect",
          "capability": "intersect_variable_case_solution",
          "public_ref": null,
          "inputs": {
            "solution": "$candidate_set",
            "case": "$case"
          },
          "outputs": {
            "case_solution": "solution"
          },
          "order": 10
        }
      ],
      "judgments": [
        {
          "id": "plan",
          "function": "endpoint_condition_plan",
          "inputs": {
            "conditions": "$normalized_conditions",
            "variable": "$parameter"
          },
          "outputs": {
            "first_condition": "first",
            "first_kind": "first_kind",
            "second_condition": "second",
            "second_kind": "second_kind",
            "absent_solution": "absent"
          },
          "options": [
            {
              "id": "single"
            },
            {
              "id": "both"
            }
          ],
          "order": 2,
          "depends_on": [
            "normalized_conditions",
            "parameter"
          ]
        }
      ],
      "display_units": [
        {
          "id": "solution",
          "after": "intersect",
          "template": "variable_conditions",
          "bindings": {
            "before": [],
            "after": [
              "$case_solution"
            ],
            "conditions": "$conditions",
            "normalized": "$normalized_conditions",
            "combiner": "$combiner",
            "solutions": "$condition_sets",
            "parameter": "$parameter"
          },
          "depends_on": [
            "case_solution",
            "combiner",
            "condition_sets",
            "conditions",
            "normalized_conditions",
            "parameter"
          ],
          "guard": {
            "ref": "has_cases",
            "equals": false
          }
        },
        {
          "id": "case_solution",
          "after": "intersect",
          "template": "variable_case_conditions",
          "bindings": {
            "before": [],
            "after": [
              "$case_solution"
            ],
            "conditions": "$conditions",
            "normalized": "$normalized_conditions",
            "combiner": "$combiner",
            "solutions": "$condition_sets",
            "parameter": "$parameter",
            "condition": "$case.condition"
          },
          "depends_on": [
            "case",
            "case_solution",
            "combiner",
            "condition_sets",
            "conditions",
            "normalized_conditions",
            "parameter"
          ],
          "guard": {
            "ref": "has_cases",
            "equals": true
          }
        }
      ],
      "merges": [
        {
          "id": "first_result",
          "order": 5,
          "branches": [
            {
              "guard": {
                "ref": "first_kind",
                "equals": "quadratic"
              },
              "bindings": {
                "first_solution": "$first_quadratic_solution"
              }
            },
            {
              "guard": {
                "ref": "first_kind",
                "equals": "affine"
              },
              "bindings": {
                "first_solution": "$first_affine_solution"
              }
            }
          ]
        },
        {
          "id": "second_result",
          "order": 8,
          "branches": [
            {
              "guard": {
                "ref": "second_kind",
                "equals": "quadratic"
              },
              "bindings": {
                "second_solution": "$second_quadratic_solution"
              }
            },
            {
              "guard": {
                "ref": "second_kind",
                "equals": "affine"
              },
              "bindings": {
                "second_solution": "$second_affine_solution"
              }
            },
            {
              "guard": {
                "ref": "second_kind",
                "equals": "absent"
              },
              "bindings": {
                "second_solution": "$absent_solution"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "merge",
      "calls": [
        {
          "id": "union",
          "capability": "merge_variable_cases",
          "public_ref": null,
          "inputs": {
            "cases": "$variable_cases",
            "results": "$variable_case_results"
          },
          "outputs": {
            "candidate_set": "solution",
            "case_solutions": "case_solutions"
          },
          "order": 0
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "case_union",
          "after": "union",
          "template": "variable_case_merge",
          "bindings": {
            "before": [],
            "after": [
              "$candidate_set"
            ],
            "cases": "$variable_cases",
            "solutions": "$case_solutions",
            "parameter": "$parameter"
          },
          "depends_on": [
            "candidate_set",
            "case_solutions",
            "parameter",
            "variable_cases"
          ],
          "guard": {
            "ref": "has_cases",
            "equals": true
          }
        }
      ]
    }
  ],
  "outputs": {
    "candidate_set": "$candidate_set"
  },
  "exits": {
    "capability_gap": {
      "status": "capability_gap"
    },
    "math_failed": {
      "status": "math_failed"
    },
    "execution_error": {
      "status": "execution_error"
    }
  },
  "admission": {
    "bindings": {
      "interval_function": {
        "resolver": "interval_function"
      },
      "interval_operator": {
        "resolver": "interval_operator"
      },
      "x": {
        "resolver": "bound_variable"
      },
      "parameter": {
        "resolver": "parameter"
      },
      "domain": {
        "resolver": "domain"
      },
      "quantifier": {
        "resolver": "quantifier"
      },
      "zero": {
        "resolver": "zero"
      }
    },
    "checks": [
      {
        "function": "quantifier",
        "inputs": {
          "quantifier": "$quantifier"
        }
      },
      {
        "function": "linear_parameter_range",
        "inputs": {
          "expression": "$interval_function",
          "variable": "$x",
          "parameter": "$parameter",
          "domain": "$domain",
          "quantifier": "$quantifier",
          "operator": "$interval_operator"
        }
      }
    ]
  }
}
