{
  "node": "method-amgm-direct",
  "items": [
    {
      "id": "when",
      "question": "什么时候可以直接用基本不等式求最值？",
      "type": "choice",
      "options": [
        {"value": "positive", "label": "只要两项都是正数", "feedback": "还要积或和是定值，并且等号取得到。"},
        {"value": "right", "label": "两项都正、积或和是定值、等号取得到"},
        {"value": "fixed", "label": "只要两项的积是定值", "feedback": "两项还必须都是正数，等号也要取得到。"}
      ],
      "answer": "right"
    },
    {
      "id": "product-fixed",
      "question": "$x>0$，$y>0$，$xy=9$，$x+y$ 的最小值是多少？",
      "type": "choice",
      "options": [
        {"value": "right", "label": "$6$"},
        {"value": "double", "label": "$18$", "feedback": "$x+y\\ge2\\sqrt{xy}=2\\times3$，不要漏开方。"},
        {"value": "nine", "label": "$9$", "feedback": "$x=y=3$ 时取等，此时 $x+y=6$。"}
      ],
      "answer": "right"
    },
    {
      "id": "sum-fixed",
      "question": "$a>0$，$b>0$，$a+b=4$，$ab$ 的最大值是多少？",
      "type": "choice",
      "options": [
        {"value": "sixteen", "label": "$16$", "feedback": "$ab\\le\\left(\\frac{a+b}2\\right)^2=2^2$。"},
        {"value": "two", "label": "$2$", "feedback": "$2$ 是取等时 $a$、$b$ 的值，$ab=2\\times2$。"},
        {"value": "right", "label": "$4$"}
      ],
      "answer": "right"
    },
    {
      "id": "coefficient",
      "question": "$x>0$ 时，$4x+\\frac1x$ 的最小值是多少？",
      "type": "choice",
      "options": [
        {"value": "five", "label": "$5$", "feedback": "$5$ 是 $x=1$ 时的值。取等要 $4x=\\frac1x$，即 $x=\\frac12$。"},
        {"value": "right", "label": "$4$"},
        {"value": "two", "label": "$2$", "feedback": "$4x\\cdot\\frac1x=4$，$2\\sqrt4=4$。"}
      ],
      "answer": "right"
    },
    {
      "id": "exponent",
      "question": "$a+b=2$，$2^a+2^b$ 的最小值是多少？",
      "type": "choice",
      "options": [
        {"value": "right", "label": "$4$"},
        {"value": "two", "label": "$2$", "feedback": "$2^a\\cdot2^b=2^{a+b}=4$，$2\\sqrt4=4$。"},
        {"value": "root", "label": "$2\\sqrt2$", "feedback": "积是 $2^{a+b}=2^2=4$，不是 $2$。"}
      ],
      "answer": "right"
    }
  ]
}
