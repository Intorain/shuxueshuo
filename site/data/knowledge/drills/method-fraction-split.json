{
  "node": "method-fraction-split",
  "items": [
    {
      "id": "split",
      "question": "$x>0$，把 $\\frac{x^2+2x+4}x$ 逐项拆开，结果是什么？",
      "type": "choice",
      "options": [
        {"value": "numer", "label": "$x+2+4$", "feedback": "每一项都要除以 $x$：$\\frac4x$ 不是 $4$。"},
        {"value": "right", "label": "$x+2+\\frac4x$"},
        {"value": "square", "label": "$x^2+2+\\frac4x$", "feedback": "$\\frac{x^2}x=x$。"}
      ],
      "answer": "right"
    },
    {
      "id": "min",
      "question": "$x>0$ 时，$\\frac{x^2+2x+4}x$ 的最小值是多少？",
      "type": "choice",
      "options": [
        {"value": "four", "label": "$4$", "feedback": "$x+\\frac4x\\ge4$，原式还有常数 $2$。"},
        {"value": "seven", "label": "$7$", "feedback": "$7$ 是 $x=1$ 时的值。取等要 $x=\\frac4x$，即 $x=2$。"},
        {"value": "right", "label": "$6$"}
      ],
      "answer": "right"
    },
    {
      "id": "shift",
      "question": "$x>1$ 时，$\\frac{x^2+1}{x-1}$ 的最小值是多少？",
      "type": "choice",
      "options": [
        {"value": "right", "label": "$2+2\\sqrt2$"},
        {"value": "missing", "label": "$2\\sqrt2$", "feedback": "令 $t=x-1$，原式 $=t+\\frac2t+2$，别漏常数 $2$。"},
        {"value": "four", "label": "$4$", "feedback": "$t\\cdot\\frac2t=2$，$t+\\frac2t\\ge2\\sqrt2$，不是 $2$。"}
      ],
      "answer": "right"
    },
    {
      "id": "first",
      "question": "分子次数比分母高时，第一步做什么？",
      "type": "choice",
      "options": [
        {"value": "direct", "label": "对分子、分母直接用基本不等式", "feedback": "基本不等式用在两项之和上，要先把分式拆成几项相加。"},
        {"value": "right", "label": "把分子按分母改写，再逐项拆开"},
        {"value": "common", "label": "先通分", "feedback": "式子本来就是一个分式，要做的是拆开，不是通分。"}
      ],
      "answer": "right"
    },
    {
      "id": "coefficient",
      "question": "$x>0$ 时，$\\frac{2x^2+3}x$ 的最小值是多少？",
      "type": "choice",
      "options": [
        {"value": "five", "label": "$5$", "feedback": "$5$ 是 $x=1$ 时的值。$2x+\\frac3x\\ge2\\sqrt6$，在 $x=\\frac{\\sqrt6}2$ 取等。"},
        {"value": "right", "label": "$2\\sqrt6$"},
        {"value": "half", "label": "$\\sqrt6$", "feedback": "$2\\sqrt{2x\\cdot\\frac3x}=2\\sqrt6$，不要漏系数 $2$。"}
      ],
      "answer": "right"
    }
  ]
}
