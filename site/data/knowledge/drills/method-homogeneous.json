{
  "node": "method-homogeneous",
  "items": [
    {
      "id": "basic",
      "question": "$a,b>0$，$a+2b=1$，$\\frac1a+\\frac1b$ 的最小值是多少？",
      "type": "choice",
      "options": [
        {"value": "twice", "label": "$4\\sqrt2$", "feedback": "这是 $\\frac1a+\\frac1b\\ge\\frac2{\\sqrt{ab}}$ 和 $a+2b\\ge2\\sqrt{2ab}$ 相乘得来的；前者 $a=b$ 取等，后者 $a=2b$ 取等，不能同时成立。"},
        {"value": "right", "label": "$3+2\\sqrt2$"},
        {"value": "missing", "label": "$2\\sqrt2$", "feedback": "$(a+2b)\\left(\\frac1a+\\frac1b\\right)=3+\\frac{2b}a+\\frac ab$，别漏常数 $3$。"}
      ],
      "answer": "right"
    },
    {
      "id": "not-one",
      "question": "$x,y>0$，$x+y=2$，$\\frac1x+\\frac9y$ 的最小值是多少？",
      "type": "choice",
      "options": [
        {"value": "sixteen", "label": "$16$", "feedback": "$x+y=2$，乘的应是 $\\frac{x+y}2$，结果还要除以 $2$。"},
        {"value": "ten", "label": "$10$", "feedback": "$(x+y)\\left(\\frac1x+\\frac9y\\right)=10+\\frac yx+\\frac{9x}y\\ge16$，再除以 $2$。"},
        {"value": "right", "label": "$8$"}
      ],
      "answer": "right"
    },
    {
      "id": "first-step",
      "question": "$a,b>0$，$2a+3b=6$，求 $\\frac2a+\\frac3b$ 的最小值，第一步写成什么？",
      "type": "choice",
      "options": [
        {"value": "right", "label": "$\\frac16\\left(\\frac2a+\\frac3b\\right)(2a+3b)$"},
        {"value": "six", "label": "$6\\left(\\frac2a+\\frac3b\\right)(2a+3b)$", "feedback": "乘的是 $\\frac{2a+3b}6=1$，系数是 $\\frac16$。"},
        {"value": "direct", "label": "$\\left(\\frac2a+\\frac3b\\right)(2a+3b)$", "feedback": "$2a+3b=6$，直接乘值变成原来的 $6$ 倍。"}
      ],
      "answer": "right"
    },
    {
      "id": "fill",
      "question": "$a,b>0$，$a+b=1$，$\\frac1a+\\frac ab$ 的最小值是多少？",
      "type": "choice",
      "options": [
        {"value": "two", "label": "$2$", "feedback": "$\\frac1a=\\frac{a+b}a=1+\\frac ba$，原式 $=1+\\frac ba+\\frac ab$，还有常数 $1$。"},
        {"value": "right", "label": "$3$"},
        {"value": "cannot", "label": "两项次数不同，不能这样做", "feedback": "把 $\\frac1a$ 里的 $1$ 换成 $a+b$，两项就都是零次了。"}
      ],
      "answer": "right"
    },
    {
      "id": "reverse",
      "question": "$x,y>0$，$\\frac1x+\\frac4y=1$，$x+y$ 的最小值是多少？",
      "type": "choice",
      "options": [
        {"value": "four", "label": "$4$", "feedback": "$(x+y)\\left(\\frac1x+\\frac4y\\right)=5+\\frac yx+\\frac{4x}y\\ge5+4$。"},
        {"value": "five", "label": "$5$", "feedback": "$5$ 只是常数部分，$\\frac yx+\\frac{4x}y\\ge4$。"},
        {"value": "right", "label": "$9$"}
      ],
      "answer": "right"
    }
  ]
}
